meta {
  name: Analyze Requirements
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/agent/analyze
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "prompt": "I want to build a smart plant watering system with WiFi.",
    "project_type": "IoT / Smart Home",
    "provider": "mock"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
