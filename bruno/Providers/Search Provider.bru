meta {
  name: Search Provider
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/providers/robotistan
  body: json
  auth: none
}

body:json {
  {
    "query": "ESP32",
    "limit": 5
  }
}

assert {
  res.status: eq 200
  res.body.provider: eq robotistan
  res.body.products: isArray
}
